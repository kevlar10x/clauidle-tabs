{
  "manifest_version": 3,
  "name": "Clauidle Tabs",
  "version": "0.6.1",
  "description": "Unofficial helper by kevlar10x. Keeps Claude's browser tabs in one window and closes the ones nobody has touched for a while.",
  "author": "kevlar10x",
  "homepage_url": "https://github.com/kevlar10x/clauidle-tabs",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabGroups", "alarms", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "action": {
    "default_popup": "options.html?popup",
    "default_title": "Clauidle Tabs",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  }
}
